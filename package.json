{
  "name": "pomotro",
  "version": "0.1.0",
  "description": "서울을 달리는 뽀모도로 — 집중하는 동안 서울 지하철 창가에 앉아 한 구간을 달리는 웹 타이머",
  "license": "MIT",
  "author": "Yohan Choi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yohan-work/pomotro.git"
  },
  "bugs": {
    "url": "https://github.com/yohan-work/pomotro/issues"
  },
  "homepage": "https://pomotro.vercel.app",
  "engines": {
    "node": ">=24"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:sim": "tsx scripts/check-sim.ts",
    "data:import": "tsx scripts/import-official-data.ts",
    "verify:browser": "node scripts/verify-browser.mjs",
    "verify:behavior": "node scripts/verify-behavior.mjs",
    "visual:diff": "node scripts/visual-diff.mjs"
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright-core": "1.64.0",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vitest": "^5.0.4"
  }
}
